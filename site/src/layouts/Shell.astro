---
// Every page is the same React app. Astro adds a real title, description and readable
// HTML for search engines and link previews; the app takes over as soon as it loads.
interface Props { title?: string; description?: string; noindex?: boolean; image?: string }
const {
  image = '/og-default.png',
  title = 'Lotmates: your locality buys together',
  description = 'Group buying for neighbourhoods. Book local services with your neighbours and the price drops for everyone. Early bookers get the difference back.',
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const imageUrl = new URL(image, Astro.site).toString();
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="alternate icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Lotmates" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="theme-color" content="#f2f5f1" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <script is:inline>
      (function () {
        var d = document.documentElement, stored = null;
        try { stored = localStorage.getItem('app-theme'); } catch (e) {}
        var mode = stored || 'system';
        var dark = mode === 'dark' || (mode === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        d.classList.toggle('dark', dark);
      })();
    </script>
    <style is:global>
      html { background: oklch(0.967 0.006 138); }
      html.dark { background: oklch(0.2 0.025 166); }
      /* Readable page text for search engines and link previews; visitors see the loader until the app paints. */
      .seo { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
      #app-loading { position: fixed; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; color: oklch(0.45 0.022 168); font: 14px/1.4 'Space Grotesk', system-ui, sans-serif; }
      .dark #app-loading { color: oklch(0.72 0.02 160); }
      #app-loading .ring { width: 28px; height: 28px; border-radius: 50%; border: 3px solid oklch(0.89 0.012 150); border-top-color: oklch(0.428 0.074 164.8); animation: lm-spin .8s linear infinite; }
      @keyframes lm-spin { to { transform: rotate(360deg); } }
      .seo-visible { max-width: 48rem; margin: 0 auto; padding: 2rem 1rem; font-family: 'Space Grotesk', system-ui, sans-serif; color: oklch(0.316 0.051 166.5); line-height: 1.6; }
      .seo-visible h1 { font-family: 'Bricolage Grotesque', system-ui, sans-serif; font-size: 2rem; line-height: 1.2; margin: 0 0 .75rem; }
      .seo-visible h2 { font-family: 'Bricolage Grotesque', system-ui, sans-serif; font-size: 1.25rem; margin: 1.5rem 0 .5rem; }
      .seo-visible a { color: oklch(0.428 0.074 164.8); }
    </style>
  </head>
  <body>
    <div id="root">
      <div id="app-loading" role="status" aria-live="polite"><div class="ring"></div><span>Lotmates</span></div>
      <main class="seo"><slot /></main>
    </div>
    <noscript><style>#app-loading{display:none}.seo{position:static;width:auto;height:auto;overflow:visible;clip-path:none;white-space:normal;max-width:48rem;margin:0 auto;padding:2rem 1rem}</style></noscript>
    <script>
      import '../app/main.jsx';
    </script>
  </body>
</html>
